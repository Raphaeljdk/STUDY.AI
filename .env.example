# ═══════════════════════════════════════════════════
# Database - NAO PRECISA CONFIGURAR NADA!
# O app ja usa PostgreSQL (Neon) automaticamente em producao.
# Local dev usa SQLite automaticamente (nenhuma config necessaria).
# ═══════════════════════════════════════════════════

# Para usar um PostgreSQL diferente, defina POSTGRES_URL:
# POSTGRES_URL=postgresql://user:pass@host/db?sslmode=require

# Local dev database (SQLite)
DATABASE_URL=file:./db/custom.db

# NextAuth - Obrigatorio no Vercel
NEXTAUTH_SECRET=gerar-um-segredo-aleatorio-aqui
NEXTAUTH_URL=https://seu-app.vercel.app

# Stripe (para assinatura Premium)
# Obtenha em: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PREMIUM_PRICE_ID=price_...
