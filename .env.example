# Database (SQLite for local dev)
DATABASE_URL=file:./db/custom.db

# Para Vercel/producao, use PostgreSQL (Neon gratis):
# 1. Crie em https://neon.tech/app/projects/create
# 2. Copie a connection string e configure no Vercel como DATABASE_URL
# Exemplo: postgresql://user:pass@ep-xxx.neon.tech/db?sslmode=require

# NextAuth
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=https://your-app.vercel.app

# Google Ads (gtag.js) — OBRIGATORIO para ativar o tracking
# Obtenha em: https://ads.google.com/aw/conversions
NEXT_PUBLIC_GADS_ID=AW-XXXXXXX

# Labels de conversao (opcionais — configure no Google Ads)
# Quando o usuario se cadastra
NEXT_PUBLIC_GADS_CONVERSION_SIGNUP=
# Quando o usuario envia mensagem no chat
NEXT_PUBLIC_GADS_CONVERSION_CHAT=
# Quando o usuario gera flashcards com IA
NEXT_PUBLIC_GADS_CONVERSION_FLASH=