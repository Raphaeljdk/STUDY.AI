# Database (SQLite for local dev)
DATABASE_URL=file:./db/custom.db

# Para Vercel/producao, use PostgreSQL (Neon gratis):
# 1. Crie em https://neon.tech/app/projects/create
# 2. Copie a connection string e configure no Vercel como DATABASE_URL
# Exemplo: postgresql://user:pass@ep-xxx.neon.tech/db?sslmode=require

# NextAuth
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=https://your-app.vercel.app

# Stripe (para assinatura Premium)
# Obtenha em: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PREMIUM_PRICE_ID=price_...
